<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>AddAgentsServlet</servlet-name>
        <servlet-class>za.ac.tut.web.AddAgentsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetAllServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetAllServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetByGenderServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetByGenderServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetStatusByGenderServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetStatusByGenderServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetByAgeServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetByAgeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetOldestServlet</servlet-name>
        <servlet-class>za.ac.tut.web.GetOldestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddAgentsServlet</servlet-name>
        <url-pattern>/AddAgentsServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetAllServlet</servlet-name>
        <url-pattern>/GetAllServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetByGenderServlet</servlet-name>
        <url-pattern>/GetByGenderServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetStatusByGenderServlet</servlet-name>
        <url-pattern>/GetStatusByGenderServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetByAgeServlet</servlet-name>
        <url-pattern>/GetByAgeServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetOldestServlet</servlet-name>
        <url-pattern>/GetOldestServlet.do</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <security-constraint>
        <display-name>AdminConstraint</display-name>
        <web-resource-collection>
            <web-resource-name>AdminResources</web-resource-name>
            <description>Resources available for Admin</description>
            <url-pattern>/age.jsp</url-pattern>
            <url-pattern>/agents_outcome.jsp</url-pattern>
            <url-pattern>/gender.jsp</url-pattern>
            <url-pattern>/get_by_age.jsp</url-pattern>
            <url-pattern>/get_by_gender.jsp /get_by_status.jsp</url-pattern>
            <url-pattern>/get_oldest.jsp</url-pattern>
            <url-pattern>/list_outcome.jsp</url-pattern>
            <url-pattern>/oldest.jsp</url-pattern>
            <url-pattern>/register.jsp</url-pattern>
            <url-pattern>/status.jsp</url-pattern>
            <url-pattern>/AddAgentsServlet.do</url-pattern>
            <url-pattern>/GetAllServlet.do</url-pattern>
            <url-pattern>/GetByAgeServlet.do</url-pattern>
            <url-pattern>/GetByGenederServlet.do</url-pattern>
            <url-pattern>/GetOldestServlet.do</url-pattern>
            <url-pattern>/GetStatusByGenderServlet.do</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description>Authenticatee the Admin role.</description>
            <role-name>admin</role-name>
        </auth-constraint>
    </security-constraint>
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>file</realm-name>
        <form-login-config>
            <form-login-page>/login.jsp</form-login-page>
            <form-error-page>/login_error.jsp</form-error-page>
        </form-login-config>
    </login-config>
    <security-role>
        <description>The admin role. This role does everything.</description>
        <role-name>admin</role-name>
    </security-role>
</web-app>
